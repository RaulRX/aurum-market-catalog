FAISS_NUM_THREADS=...
OPENAI_API_KEY=....
COHERE_API_KEY=...
GEMINI_API_KEY=...
HF_TOKEN=...

# ── NB04 · Motores candidatos de D12 ─────────────────────────────────────────
# Mismo esquema que ../sesion_03/.env.example, adaptado a este repo: endpoint por
# motor, credencial OPCIONAL y vacía en local, y las operaciones destructivas
# desactivadas salvo que se activen a mano.
#
# Los endpoints NO son secretos: son los que levantan los compose de docker/.
# Están aquí para que el notebook no lleve el host escrito en una celda.
AURUM_QDRANT_URL=...
AURUM_QDRANT_GRPC_PORT=...
AURUM_WEAVIATE_HOST=...
AURUM_WEAVIATE_PORT=...
AURUM_WEAVIATE_GRPC_PORT=...
AURUM_MILVUS_URI=...

# Credenciales de los motores. En local van VACÍAS y el adaptador las convierte
# en `None`: los compose de docker/ no activan autenticación. Solo tienen valor
# contra una instancia protegida (Qdrant Cloud, Zilliz, o un contenedor
# arrancado con QDRANT__SERVICE__API_KEY). El dashboard de Qdrant en :6333 no
# las necesita. Déjalas vacías salvo que sepas que tu instancia las pide.
AURUM_QDRANT_API_KEY=
AURUM_WEAVIATE_API_KEY=
AURUM_MILVUS_TOKEN=

# Prefijo de la colección de la prueba de humo. Se le añade el nombre del motor.
# Primera salvaguarda: los adaptadores rechazan operar sobre una colección que
# no empiece por él.
AURUM_COLECCION_HUMO=aurum_humo

# Segunda salvaguarda, copiada de S03_ALLOW_RESET de la sesión 3: borrar y
# recrear la colección nunca se habilita de forma implícita. El guion de humo lo
# necesita en cada pasada, así que ponla a `true` mientras dure NB04 y devuélvela
# a `false` cuando el índice bueno esté construido.
AURUM_ALLOW_RESET=false
